#!/usr/bin/env bash
# greenfield-tiers: fixed model and effort levels for each subagent role.
set -u

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PLUGIN_TIERS="${GREENFIELD_TIERS_FILE:-$SCRIPT_DIR/../model-tiers.tsv}"

MODELS=(haiku sonnet opus fable)
EFFORTS=(low medium high xhigh max)

die() {
  local code=$1
  shift
  echo "greenfield-tiers: $*" >&2
  exit "$code"
}

# Print the index of $1 in the list that follows it. Return 1 if absent.
rank_in() {
  local want=$1 i=0 item
  shift
  for item in "$@"; do
    if [ "$item" = "$want" ]; then
      echo "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

model_rank() { rank_in "${1:-}" "${MODELS[@]}"; }
effort_rank() { rank_in "${1:-}" "${EFFORTS[@]}"; }

ws_tiers() {
  local f="$1/provenance/model-tiers.tsv"
  [ -f "$f" ] || die 2 "no tier file in workspace; run greenfield-tiers init"
  echo "$f"
}

# Print normalized rows: "tier <name> <model> <effort>" and "role <name> <tier>".
# Dies with code 2 if the file is invalid. Call as: rows=$(load_tiers f) || exit $?
load_tiers() {
  local file=$1 kind a b c extra
  local tiers=" " roles=" "
  [ -f "$file" ] || die 2 "invalid tier file: $file not found"
  while read -r kind a b c extra; do
    case "$kind" in
      "" | "#"*) continue ;;
    esac
    case "$kind" in
      tier)
        [ -n "$c" ] && [ -z "$extra" ] || die 2 "invalid tier file: bad tier row for '$a'"
        case "$a" in deep | standard | light) ;; *) die 2 "invalid tier file: unknown tier '$a'" ;; esac
        case "$tiers" in *" $a "*) die 2 "invalid tier file: tier '$a' repeated" ;; esac
        model_rank "$b" >/dev/null || die 2 "invalid tier file: unknown model '$b'"
        effort_rank "$c" >/dev/null || die 2 "invalid tier file: unknown effort '$c'"
        tiers="$tiers$a "
        echo "tier $a $b $c"
        ;;
      role)
        [ -n "$b" ] && [ -z "$c" ] || die 2 "invalid tier file: bad role row for '$a'"
        case "$b" in deep | standard | light) ;; *) die 2 "invalid tier file: role '$a' has unknown tier '$b'" ;; esac
        case "$roles" in *" $a "*) die 2 "invalid tier file: role '$a' repeated" ;; esac
        roles="$roles$a "
        echo "role $a $b"
        ;;
      *) die 2 "invalid tier file: unknown row type '$kind'" ;;
    esac
  done < <(tr -d '\r' <"$file")
  case "$tiers" in *" deep "*) ;; *) die 2 "invalid tier file: missing tier deep" ;; esac
  case "$tiers" in *" standard "*) ;; *) die 2 "invalid tier file: missing tier standard" ;; esac
  case "$tiers" in *" light "*) ;; *) die 2 "invalid tier file: missing tier light" ;; esac
}

# Print "<model> <effort>" for a tier name from normalized rows on $1.
tier_pair() {
  local rows=$1 name=$2 k n m e
  while read -r k n m e; do
    if [ "$k" = tier ] && [ "$n" = "$name" ]; then
      echo "$m $e"
      return 0
    fi
  done <<EOF
$rows
EOF
  return 1
}

# Print the tier name of a role from normalized rows on $1.
role_tier() {
  local rows=$1 name=$2 k n t
  while read -r k n t; do
    if [ "$k" = role ] && [ "$n" = "$name" ]; then
      echo "$t"
      return 0
    fi
  done <<EOF
$rows
EOF
  return 1
}

# Print "<model> <effort>" of the role's own tier. Return 1 for an unknown role.
role_floor() {
  local rows t
  rows=$(load_tiers "$1") || exit $?
  t=$(role_tier "$rows" "$2") || return 1
  tier_pair "$rows" "$t"
}

cmd_init() {
  [ $# -eq 1 ] || die 2 "usage: greenfield-tiers init <workspace>"
  local ws=$1
  [ -d "$ws" ] || die 2 "workspace not found: $ws"
  local dest="$ws/provenance/model-tiers.tsv"
  if [ -f "$dest" ]; then
    echo "INIT kept"
    return 0
  fi
  load_tiers "$PLUGIN_TIERS" >/dev/null || exit $?
  mkdir -p "$ws/provenance" || die 2 "cannot create $ws/provenance"
  cp "$PLUGIN_TIERS" "$dest" || die 2 "cannot copy tier file"
  local f list=""
  for f in "$ws"/provenance/dispatch/*.md; do
    [ -e "$f" ] || continue
    grep -q '^\*\*Model:\*\*' "$f" && continue
    list="$list$(basename "$f")
"
  done
  if [ -n "$list" ]; then
    printf '%s' "$list" >"$ws/provenance/model-tiers-baseline.txt"
  fi
  echo "INIT copied"
}

cmd_lookup() {
  { [ $# -eq 2 ] || [ $# -eq 3 ]; } || die 2 "usage: greenfield-tiers lookup <workspace> <role> [steps]"
  local ws=$1 role=$2 steps=${3:-0}
  case "$steps" in
    "" | *[!0-9]*) die 2 "steps must be a non-negative integer" ;;
  esac
  local f rows
  f=$(ws_tiers "$ws") || exit $?
  rows=$(load_tiers "$f") || exit $?
  local t
  t=$(role_tier "$rows" "$role") || die 1 "unknown role: $role"
  local pos
  case "$t" in light) pos=0 ;; standard) pos=1 ;; *) pos=2 ;; esac
  pos=$((pos + steps))
  [ "$pos" -le 3 ] || pos=3
  local name pair model effort
  if [ "$pos" -le 2 ]; then
    case "$pos" in 0) name=light ;; 1) name=standard ;; *) name=deep ;; esac
    pair=$(tier_pair "$rows" "$name")
    echo "$pair"
  else
    pair=$(tier_pair "$rows" deep)
    model=${pair% *}
    effort=${pair#* }
    if [ "$(effort_rank "$effort")" -lt "$(effort_rank xhigh)" ]; then
      effort=xhigh
    fi
    echo "$model $effort"
  fi
}

# Print the value of the first "**<key>:**" line above the first line that
# starts with three backticks. Return 1 if there is no such line.
header_value() {
  local line prefix="**$2:**"
  while IFS= read -r line; do
    line=${line%$'\r'}
    case "$line" in
      '```'*) return 1 ;;
      "$prefix"*)
        line=${line#"$prefix"}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        printf '%s\n' "$line"
        return 0
        ;;
    esac
  done <"$1"
  return 1
}

# Print the base name of the record in directory $2 that names $1 in its
# **Supersedes:** header. Return 1 if none does.
superseded_by() {
  local name=$1 dir=$2 other base sup s
  for other in "$dir"/*.md; do
    [ -e "$other" ] || continue
    base=$(basename "$other")
    [ "$base" = "$name" ] && continue
    sup=$(header_value "$other" Supersedes) || continue
    for s in ${sup//,/ }; do
      if [ "$s" = "$name" ]; then
        echo "$base"
        return 0
      fi
    done
  done
  return 1
}

# Check one record against its role floor. Print one SKIP, FAIL, or PASS line.
# Return 1 if the line is FAIL. Args: <rows> <dir> <baseline file> <record>
floor_check_record() {
  local rows=$1 dir=$2 baseline=$3 rec=$4
  local name role model effort raised key other
  name=$(basename "$rec")

  if [ -f "$baseline" ] && grep -qxF "$name" <(tr -d '\r' <"$baseline"); then
    echo "SKIP $name: predates model tiers"
    return 0
  fi
  if other=$(superseded_by "$name" "$dir"); then
    echo "SKIP $name: superseded by $other"
    return 0
  fi

  for key in Role Model Effort Raised; do
    if ! header_value "$rec" "$key" >/dev/null; then
      echo "FAIL $name: missing **$key:** line"
      return 1
    fi
  done
  role=$(header_value "$rec" Role)
  model=$(header_value "$rec" Model)
  effort=$(header_value "$rec" Effort)
  raised=$(header_value "$rec" Raised)

  local tier pair fmodel feffort
  if ! tier=$(role_tier "$rows" "$role"); then
    echo "FAIL $name: unknown role '$role'"
    return 1
  fi
  pair=$(tier_pair "$rows" "$tier")
  fmodel=${pair% *}
  feffort=${pair#* }

  local mr er fmr fer
  if ! mr=$(model_rank "$model"); then
    echo "FAIL $name: unknown model '$model'"
    return 1
  fi
  if ! er=$(effort_rank "$effort"); then
    echo "FAIL $name: unknown effort '$effort'"
    return 1
  fi
  fmr=$(model_rank "$fmodel")
  fer=$(effort_rank "$feffort")
  if [ "$mr" -lt "$fmr" ]; then
    echo "FAIL $name: model $model is below the floor $fmodel for $role"
    return 1
  fi
  if [ "$er" -lt "$fer" ]; then
    echo "FAIL $name: effort $effort is below the floor $feffort for $role"
    return 1
  fi
  case "$raised" in
    no | "yes: "?*) ;;
    *)
      echo "FAIL $name: **Raised:** must be 'no' or 'yes: <reason>'"
      return 1
      ;;
  esac
  if [ "$raised" = no ] && { [ "$mr" -gt "$fmr" ] || [ "$er" -gt "$fer" ]; }; then
    echo "FAIL $name: above the floor but **Raised:** is no"
    return 1
  fi
  echo "PASS $name $role $model/$effort"
  return 0
}

have_jq() { [ -z "${GREENFIELD_NO_JQ:-}" ] && command -v jq >/dev/null 2>&1; }

# Map a model ID to the alias named inside it. Return 1 if it names none.
model_alias() {
  case "$1" in
    *fable*) echo fable ;;
    *opus*) echo opus ;;
    *sonnet*) echo sonnet ;;
    *haiku*) echo haiku ;;
    *) return 1 ;;
  esac
}

# Compare the models in the session logs of one record with the role floor.
# Print FAIL and WARN lines. Return 1 if any line is FAIL. Needs jq.
# Args: <rows> <workspace> <record>
floor_check_logs() {
  local rows=$1 ws=$2 rec=$3
  local name entries line erole elog tier pair fmodel fmr
  local logfile lname id alias ar failed=0
  name=$(basename "$rec")

  if [ -f "$ws/workspace.json" ]; then
    entries=$(jq -r --arg b "$name" '
      .agent_runs[]?
      | select(((.dispatch_record // "") | split("/") | last) == $b)
      | "\(.role // "")|\(.session_log // "")"' "$ws/workspace.json" 2>/dev/null)
  else
    entries=""
  fi
  if [ -z "$entries" ]; then
    echo "WARN $name: no agent_runs entry"
    return 0
  fi

  while IFS= read -r line; do
    erole=${line%%|*}
    elog=${line#*|}
    logfile="$ws/$elog"
    if [ -z "$elog" ] || [ ! -f "$logfile" ]; then
      echo "WARN $name: no session log"
      continue
    fi
    lname=$(basename "$logfile")
    if ! tier=$(role_tier "$rows" "$erole"); then
      echo "WARN $name: agent_runs role '$erole' is not in the tier file"
      continue
    fi
    pair=$(tier_pair "$rows" "$tier")
    fmodel=${pair% *}
    fmr=$(model_rank "$fmodel")
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      if ! alias=$(model_alias "$id"); then
        echo "WARN $lname: model ID '$id' names no known alias"
        continue
      fi
      ar=$(model_rank "$alias")
      if [ "$ar" -lt "$fmr" ]; then
        echo "FAIL $lname: ran on $id, below the floor $fmodel for $erole"
        failed=1
      fi
    done < <(jq -r 'select(.type=="assistant") | .message.model // empty' "$logfile" 2>/dev/null | sort -u)
  done <<EOF
$entries
EOF
  return "$failed"
}

cmd_floor() {
  [ $# -eq 2 ] || die 2 "usage: greenfield-tiers floor <workspace> <layer>"
  local ws=$1 layer=$2
  case "$layer" in
    [1-7]) ;;
    *) die 2 "layer must be a number from 1 to 7" ;;
  esac
  local f rows
  f=$(ws_tiers "$ws") || exit $?
  rows=$(load_tiers "$f") || exit $?
  local dir="$ws/provenance/dispatch"
  local baseline="$ws/provenance/model-tiers-baseline.txt"
  local rec found=0 failed=0 out rc jq_warned=0
  for rec in "$dir"/L"$layer"-*.md; do
    [ -e "$rec" ] || continue
    found=1
    rc=0
    out=$(floor_check_record "$rows" "$dir" "$baseline" "$rec") || rc=$?
    printf '%s\n' "$out"
    [ "$rc" -eq 0 ] || failed=1
    case "$out" in SKIP*) continue ;; esac
    if have_jq; then
      out=$(floor_check_logs "$rows" "$ws" "$rec") || failed=1
      [ -z "$out" ] || printf '%s\n' "$out"
    elif [ "$jq_warned" -eq 0 ]; then
      echo "WARN L$layer: jq is not installed, session logs not compared"
      jq_warned=1
    fi
  done
  if [ "$found" -eq 0 ]; then
    echo "FAIL L$layer: no dispatch records"
    failed=1
  fi
  if [ "$failed" -eq 0 ]; then
    echo "FLOOR L$layer: PASS"
    return 0
  fi
  echo "FLOOR L$layer: FAIL"
  return 1
}

MIN_VERSION="2.1.292"

cmd_preflight() {
  [ $# -eq 0 ] || die 2 "usage: greenfield-tiers preflight"
  local found=0
  if [ -n "${CLAUDE_CODE_SUBAGENT_MODEL_FORCE:-}" ]; then
    echo "OVERRIDE CLAUDE_CODE_SUBAGENT_MODEL_FORCE is set: Claude Code ignores the model of every dispatch"
    found=1
  fi
  if [ -n "${CLAUDE_CODE_EFFORT_LEVEL:-}" ]; then
    echo "OVERRIDE CLAUDE_CODE_EFFORT_LEVEL is set: Claude Code ignores the effort of every dispatch"
    found=1
  fi

  local text=""
  if [ -n "${GREENFIELD_CLAUDE_VERSION+x}" ]; then
    text=$GREENFIELD_CLAUDE_VERSION
  elif command -v claude >/dev/null 2>&1; then
    text=$(claude --version 2>/dev/null) || text=""
  fi

  if [[ $text =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
    local ver="${BASH_REMATCH[0]}"
    local have=("$((10#${BASH_REMATCH[1]}))" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]}))")
    local need=(2 1 292) i older=0
    for i in 0 1 2; do
      if [ "${have[$i]}" -lt "${need[$i]}" ]; then
        older=1
        break
      fi
      [ "${have[$i]}" -gt "${need[$i]}" ] && break
    done
    if [ "$older" -eq 1 ]; then
      echo "OVERRIDE Claude Code $ver is older than $MIN_VERSION: the per-call effort parameter is not available"
      found=1
    fi
  else
    echo "OVERRIDE Claude Code version is unknown"
    found=1
  fi

  if [ "$found" -eq 0 ]; then
    echo "PREFLIGHT OK"
    return 0
  fi
  return 3
}

cmd_substitute() {
  [ $# -eq 5 ] || die 2 "usage: greenfield-tiers substitute <workspace> <tier> <model> <effort> <reason>"
  local ws=$1 tier=$2 model=$3 effort=$4 reason
  case "$tier" in deep | standard | light) ;; *) die 2 "unknown tier: $tier" ;; esac
  model_rank "$model" >/dev/null || die 2 "unknown model: $model"
  effort_rank "$effort" >/dev/null || die 2 "unknown effort: $effort"
  reason=$(printf '%s' "$5" | tr '\r\n' '  ')
  [ -n "${reason//[[:space:]]/}" ] || die 2 "a reason is required"

  local f rows pair old_model old_effort
  f=$(ws_tiers "$ws") || exit $?
  rows=$(load_tiers "$f") || exit $?
  pair=$(tier_pair "$rows" "$tier")
  old_model=${pair% *}
  old_effort=${pair#* }

  local tmp="$f.tmp.$$" line plain kind name replaced=0
  : >"$tmp" || die 2 "cannot write $tmp"
  while IFS= read -r line || [ -n "$line" ]; do
    plain=${line%$'\r'}
    read -r kind name _ <<EOF
$plain
EOF
    if [ "$kind" = tier ] && [ "$name" = "$tier" ] && [ "$replaced" -eq 0 ]; then
      printf 'tier\t%s\t%s\t%s' "$tier" "$model" "$effort" >>"$tmp"
      [ "$plain" = "$line" ] || printf '\r' >>"$tmp"
      printf '\n' >>"$tmp"
      replaced=1
    else
      printf '%s\n' "$line" >>"$tmp"
    fi
  done <"$f"
  if [ "$replaced" -eq 0 ]; then
    rm -f "$tmp"
    die 2 "tier row for '$tier' not found"
  fi
  printf '# substituted %s: %s/%s -> %s/%s at %s: %s\n' \
    "$tier" "$old_model" "$old_effort" "$model" "$effort" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" >>"$tmp"
  mv "$tmp" "$f" || die 2 "cannot update $f"
  echo "SUBSTITUTED $tier: $old_model/$old_effort -> $model/$effort"
}

main() {
  [ $# -ge 1 ] || die 2 "usage: greenfield-tiers <init|lookup|floor|preflight|substitute> ..."
  local sub=$1
  shift
  case "$sub" in
    init) cmd_init "$@" ;;
    lookup) cmd_lookup "$@" ;;
    floor) cmd_floor "$@" ;;
    preflight) cmd_preflight "$@" ;;
    substitute) cmd_substitute "$@" ;;
    *) die 2 "unknown subcommand: $sub" ;;
  esac
}

main "$@"
